{
  "detection": {
    "yolo_model": "yolo11n.pt",
    "confidence_threshold": 0.3,
    "iou_threshold": 0.5,
    "device": "auto",
    "classes": [0]
  },
  "sahi": {
    "enabled": true,
    "slice_height": 512,
    "slice_width": 512,
    "overlap_height_ratio": 0.2,
    "overlap_width_ratio": 0.2,
    "postprocess_type": "GREEDYNMM",
    "postprocess_match_threshold": 0.5
  },
  "equirectangular": {
    "use_perspective_patches": true,
    "patch_size": [640, 640],
    "fov_degrees": 90,
    "yaw_angles": [0, 45, 90, 135, 180, 225, 270, 315],
    "pitch_angles": [-10, 0, 10],
    "overlap_ratio": 0.2
  },
  "grounded_sam": {
    "enabled": false,
    "text_prompt": "person. people. human. walking. standing.",
    "use_fallback": true
  },
  "tracking": {
    "max_track_age": 30,
    "min_track_length": 5,
    "track_buffer_size": 50
  },
  "output": {
    "export_visualizations": true,
    "export_position_history": true,
    "position_history_length": 10,
    "coordinate_format": "xyxy"
  }
}